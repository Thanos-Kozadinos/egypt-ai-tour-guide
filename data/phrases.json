{
  "legend": {
    "transliteration": "Simple Latin spelling. Capital letters inside a word are not used; ' marks a glottal stop (the Egyptian way of saying the letter qaf, written 2 in Franco-Arabic); 3 in Franco-Arabic is the deep 'ayn sound; kh (Franco 5) is the Scottish 'loch' sound; gh is a French r; H is a breathy h from the throat (Franco 7); long vowels are doubled.",
    "speaker": "Some phrases change with the gender of the person SPEAKING (m/f). The app shows the form for the selected speaker.",
    "listener": "Some phrases change with the gender of the person you ADDRESS. The app shows two play buttons: 'to a man' and 'to a woman'."
  },
  "categories": ["Greetings & politeness", "Yes, no, OK", "Shopping & bargaining", "Touts & boundaries", "Getting around", "Food & drink", "Help & emergencies", "Blessings & bonding", "Numbers & money"],
  "phrases": [
    {"id": "hello", "cat": "Greetings & politeness", "en": "Hello", "note": "The everyday hello. Reply: ahlan beek (to a man) / ahlan beeki (to a woman).", "forms": [{"who": "any", "to": "any", "ar": "أهلاً", "tr": "ahlan"}]},
    {"id": "hello-formal", "cat": "Greetings & politeness", "en": "Peace be upon you (formal hello)", "note": "Reply: wa 3aleikum es-salaam.", "forms": [{"who": "any", "to": "any", "ar": "السلام عليكم", "tr": "es-salaamu 3aleikum"}]},
    {"id": "good-morning", "cat": "Greetings & politeness", "en": "Good morning", "note": "Reply: sabaaH en-noor (morning of light).", "forms": [{"who": "any", "to": "any", "ar": "صباح الخير", "tr": "sabaaH el-kheir"}]},
    {"id": "good-evening", "cat": "Greetings & politeness", "en": "Good evening", "note": "Reply: masaa' en-noor.", "forms": [{"who": "any", "to": "any", "ar": "مساء الخير", "tr": "masaa' el-kheir"}]},
    {"id": "how-are-you", "cat": "Greetings & politeness", "en": "How are you?", "note": "To a group: izzayyukum.", "forms": [{"who": "any", "to": "m", "ar": "إزيك؟", "tr": "izzayyak?"}, {"who": "any", "to": "f", "ar": "إزيك؟", "tr": "izzayyik?"}]},
    {"id": "im-fine", "cat": "Greetings & politeness", "en": "I'm fine, thank God", "note": "", "forms": [{"who": "m", "to": "any", "ar": "كويس، الحمد لله", "tr": "kwayyis, el-Hamdu lillaah"}, {"who": "f", "to": "any", "ar": "كويسة، الحمد لله", "tr": "kwayyisa, el-Hamdu lillaah"}]},
    {"id": "thanks", "cat": "Greetings & politeness", "en": "Thank you", "note": "", "forms": [{"who": "any", "to": "any", "ar": "شكراً", "tr": "shukran"}]},
    {"id": "thanks-a-lot", "cat": "Greetings & politeness", "en": "Thanks a lot", "note": "Warmer than shukran.", "forms": [{"who": "m", "to": "any", "ar": "متشكر أوي", "tr": "mutashakkir awi"}, {"who": "f", "to": "any", "ar": "متشكرة أوي", "tr": "mutashakkira awi"}]},
    {"id": "youre-welcome", "cat": "Greetings & politeness", "en": "You're welcome", "note": "Also: el-3afw.", "forms": [{"who": "any", "to": "any", "ar": "عفواً", "tr": "3afwan"}]},
    {"id": "please", "cat": "Greetings & politeness", "en": "Please / excuse me (to get attention)", "note": "The all-purpose polite opener: waiter, shopkeeper, stranger.", "forms": [{"who": "any", "to": "m", "ar": "لو سمحت", "tr": "law samaHt"}, {"who": "any", "to": "f", "ar": "لو سمحتي", "tr": "law samaHti"}]},
    {"id": "please-kindly", "cat": "Greetings & politeness", "en": "Please (from your kindness)", "note": "Slightly more formal than law samaHt.", "forms": [{"who": "any", "to": "m", "ar": "من فضلك", "tr": "min fadlak"}, {"who": "any", "to": "f", "ar": "من فضلك", "tr": "min fadlik"}]},
    {"id": "excuse-me-passing", "cat": "Greetings & politeness", "en": "Excuse me (passing by / leaving)", "note": "Literally 'with your permission'. Your 'Ba'do iznak'.", "forms": [{"who": "any", "to": "m", "ar": "بعد إذنك", "tr": "ba3d iznak"}, {"who": "any", "to": "f", "ar": "بعد إذنك", "tr": "ba3d iznik"}]},
    {"id": "sorry", "cat": "Greetings & politeness", "en": "Sorry", "note": "", "forms": [{"who": "m", "to": "any", "ar": "آسف", "tr": "aasif"}, {"who": "f", "to": "any", "ar": "آسفة", "tr": "asfa"}]},
    {"id": "goodbye", "cat": "Greetings & politeness", "en": "Goodbye", "note": "", "forms": [{"who": "any", "to": "any", "ar": "مع السلامة", "tr": "ma3a s-salaama"}]},
    {"id": "nice-to-meet", "cat": "Greetings & politeness", "en": "Nice to meet you", "note": "Reply: ana as3ad (I am happier).", "forms": [{"who": "any", "to": "any", "ar": "فرصة سعيدة", "tr": "forsa sa3eeda"}]},
    {"id": "my-name-is", "cat": "Greetings & politeness", "en": "My name is ...", "note": "", "forms": [{"who": "any", "to": "any", "ar": "اسمي ...", "tr": "ismi ..."}]},
    {"id": "im-from-greece", "cat": "Greetings & politeness", "en": "I'm from Greece", "note": "Egyptians love this. Swap el-yunaan for your country if needed.", "forms": [{"who": "any", "to": "any", "ar": "أنا من اليونان", "tr": "ana min el-yunaan"}]},
    {"id": "yes", "cat": "Yes, no, OK", "en": "Yes", "note": "aywa is the standard yes; aah is the casual one from your list.", "forms": [{"who": "any", "to": "any", "ar": "أيوه / آه", "tr": "aywa / aah"}]},
    {"id": "no", "cat": "Yes, no, OK", "en": "No", "note": "Short, with a little stop at the end.", "forms": [{"who": "any", "to": "any", "ar": "لأ", "tr": "la'"}]},
    {"id": "ok", "cat": "Yes, no, OK", "en": "OK / fine / deal", "note": "maashi = OK, moving on; tamaam = perfect, all good.", "forms": [{"who": "any", "to": "any", "ar": "ماشي / تمام", "tr": "maashi / tamaam"}]},
    {"id": "khalas", "cat": "Yes, no, OK", "en": "Enough / that's it / done", "note": "Your '5alaas'. Ends a negotiation, a conversation, a plate of food. Very useful.", "forms": [{"who": "any", "to": "any", "ar": "خلاص", "tr": "khalaas"}]},
    {"id": "yalla", "cat": "Yes, no, OK", "en": "Let's go / come on", "note": "", "forms": [{"who": "any", "to": "any", "ar": "يلا", "tr": "yalla"}]},
    {"id": "no-problem", "cat": "Yes, no, OK", "en": "No problem", "note": "", "forms": [{"who": "any", "to": "any", "ar": "مفيش مشكلة", "tr": "mafeesh mushkila"}]},
    {"id": "dont-understand", "cat": "Yes, no, OK", "en": "I don't understand", "note": "", "forms": [{"who": "m", "to": "any", "ar": "مش فاهم", "tr": "mish faahim"}, {"who": "f", "to": "any", "ar": "مش فاهمة", "tr": "mish fahma"}]},
    {"id": "speak-english", "cat": "Yes, no, OK", "en": "Do you speak English?", "note": "", "forms": [{"who": "any", "to": "m", "ar": "بتتكلم إنجليزي؟", "tr": "bititkallim ingileezi?"}, {"who": "any", "to": "f", "ar": "بتتكلمي إنجليزي؟", "tr": "bititkallimi ingileezi?"}]},
    {"id": "how-much", "cat": "Shopping & bargaining", "en": "How much is this?", "note": "Your 'Bikam?'. Add 'da' (this) when pointing.", "forms": [{"who": "any", "to": "any", "ar": "بكام ده؟", "tr": "bikaam da?"}]},
    {"id": "too-expensive", "cat": "Shopping & bargaining", "en": "Too expensive!", "note": "Say it with a smile and a wince.", "forms": [{"who": "any", "to": "any", "ar": "غالي أوي", "tr": "ghaali awi"}]},
    {"id": "cheaper", "cat": "Shopping & bargaining", "en": "Can you make it cheaper?", "note": "", "forms": [{"who": "any", "to": "any", "ar": "ممكن أرخص؟", "tr": "mumkin arkhas?"}]},
    {"id": "final-price", "cat": "Shopping & bargaining", "en": "Final price?", "note": "Literally 'last word?'", "forms": [{"who": "any", "to": "any", "ar": "آخر كلام؟", "tr": "aakhir kalaam?"}]},
    {"id": "just-looking", "cat": "Shopping & bargaining", "en": "I'm just looking", "note": "", "forms": [{"who": "m", "to": "any", "ar": "بس بتفرج", "tr": "bass batfarrag"}, {"who": "f", "to": "any", "ar": "بس بتفرج", "tr": "bass batfarrag"}]},
    {"id": "dont-want", "cat": "Shopping & bargaining", "en": "I don't want (it)", "note": "", "forms": [{"who": "m", "to": "any", "ar": "مش عايز", "tr": "mish 3aayiz"}, {"who": "f", "to": "any", "ar": "مش عايزة", "tr": "mish 3ayza"}]},
    {"id": "no-thanks", "cat": "Shopping & bargaining", "en": "No, thank you", "note": "", "forms": [{"who": "any", "to": "any", "ar": "لأ، شكراً", "tr": "la', shukran"}]},
    {"id": "no-change", "cat": "Shopping & bargaining", "en": "I don't have change", "note": "Also what they will tell you. Carry small notes.", "forms": [{"who": "any", "to": "any", "ar": "معنديش فكة", "tr": "ma3andeesh fakka"}]},
    {"id": "pay-by-card", "cat": "Shopping & bargaining", "en": "Can I pay by card?", "note": "", "forms": [{"who": "any", "to": "any", "ar": "ممكن أدفع بالكارت؟", "tr": "mumkin adfa3 bil-kart?"}]},
    {"id": "the-bill", "cat": "Shopping & bargaining", "en": "The bill, please", "note": "", "forms": [{"who": "any", "to": "m", "ar": "الحساب لو سمحت", "tr": "el-Hisaab law samaHt"}, {"who": "any", "to": "f", "ar": "الحساب لو سمحتي", "tr": "el-Hisaab law samaHti"}]},
    {"id": "this-is-for-you", "cat": "Shopping & bargaining", "en": "This is for you (giving a tip)", "note": "", "forms": [{"who": "any", "to": "m", "ar": "ده علشانك", "tr": "da 3alashaanak"}, {"who": "any", "to": "f", "ar": "ده علشانك", "tr": "da 3alashaanik"}]},
    {"id": "no-guide", "cat": "Touts & boundaries", "en": "I don't want a guide, thanks", "note": "Polite but final. Keep walking.", "forms": [{"who": "m", "to": "any", "ar": "مش عايز مرشد، شكراً", "tr": "mish 3aayiz murshid, shukran"}, {"who": "f", "to": "any", "ar": "مش عايزة مرشد، شكراً", "tr": "mish 3ayza murshid, shukran"}]},
    {"id": "we-are-fine", "cat": "Touts & boundaries", "en": "We're fine, thanks", "note": "", "forms": [{"who": "any", "to": "any", "ar": "إحنا كويسين، شكراً", "tr": "iHna kwayyiseen, shukran"}]},
    {"id": "i-know-the-way", "cat": "Touts & boundaries", "en": "I know the way", "note": "For the 'closed today, come this way' routine.", "forms": [{"who": "m", "to": "any", "ar": "أنا عارف الطريق", "tr": "ana 3aarif et-taree'"}, {"who": "f", "to": "any", "ar": "أنا عارفة الطريق", "tr": "ana 3arfa et-taree'"}]},
    {"id": "god-provide", "cat": "Touts & boundaries", "en": "May God provide for you (polite no to a request for money)", "note": "Your 'rabbena yerzo2ak'. The classic gentle refusal to beggars and insistent sellers: it means 'not from me, but God will'.", "forms": [{"who": "any", "to": "m", "ar": "ربنا يرزقك", "tr": "rabbena yirzu'ak"}, {"who": "any", "to": "f", "ar": "ربنا يرزقك", "tr": "rabbena yirzu'ik"}]},
    {"id": "god-make-easy", "cat": "Touts & boundaries", "en": "May God make it easy for you", "note": "Your 'allah yesahhellak'. Said when parting, wishing luck, or as a soft 'good luck with that' refusal. Also simply: rabbena yisahhil.", "forms": [{"who": "any", "to": "m", "ar": "الله يسهّل لك", "tr": "allaah yisahhil-lak"}, {"who": "any", "to": "f", "ar": "الله يسهّل لك", "tr": "allaah yisahhil-lik"}]},
    {"id": "leave-me-please", "cat": "Touts & boundaries", "en": "Leave me alone, please (firm)", "note": "Only when needed. Firm tone, no smile.", "forms": [{"who": "any", "to": "m", "ar": "سيبني لو سمحت", "tr": "seebni law samaHt"}, {"who": "any", "to": "f", "ar": "سيبيني لو سمحتي", "tr": "seebeeni law samaHti"}]},
    {"id": "where-is", "cat": "Getting around", "en": "Where is ...?", "note": "fein + the place.", "forms": [{"who": "any", "to": "any", "ar": "فين ...؟", "tr": "fein ...?"}]},
    {"id": "where-toilet", "cat": "Getting around", "en": "Where's the bathroom?", "note": "", "forms": [{"who": "any", "to": "any", "ar": "فين الحمام؟", "tr": "fein el-Hammaam?"}]},
    {"id": "directions", "cat": "Getting around", "en": "Straight / right / left", "note": "", "forms": [{"who": "any", "to": "any", "ar": "على طول / يمين / شمال", "tr": "3ala tool / yimeen / shimaal"}]},
    {"id": "stop-here", "cat": "Getting around", "en": "Here is fine (stop here)", "note": "", "forms": [{"who": "any", "to": "any", "ar": "هنا كويس", "tr": "hina kwayyis"}]},
    {"id": "meter", "cat": "Getting around", "en": "Use the meter, please", "note": "For taxis. Or agree the price first.", "forms": [{"who": "any", "to": "any", "ar": "بالعداد لو سمحت", "tr": "bil-3addaad law samaHt"}]},
    {"id": "how-much-to", "cat": "Getting around", "en": "How much to ... ?", "note": "bikaam li + place, e.g. bikaam lil-mataar (to the airport).", "forms": [{"who": "any", "to": "any", "ar": "بكام لـ ...؟", "tr": "bikaam li ...?"}]},
    {"id": "slow-down", "cat": "Getting around", "en": "Slow down!", "note": "You will need this in a car.", "forms": [{"who": "any", "to": "m", "ar": "على مهلك", "tr": "3ala mahlak"}, {"who": "any", "to": "f", "ar": "على مهلك", "tr": "3ala mahlik"}]},
    {"id": "far-near", "cat": "Getting around", "en": "Far? / Near?", "note": "", "forms": [{"who": "any", "to": "any", "ar": "بعيد؟ / قريب؟", "tr": "bi3eed? / 'urayyib?"}]},
    {"id": "places", "cat": "Getting around", "en": "Airport / station / hotel / museum / temple", "note": "", "forms": [{"who": "any", "to": "any", "ar": "المطار / المحطة / الفندق / المتحف / المعبد", "tr": "el-mataar / el-maHatta / el-fondo' / el-matHaf / el-ma3bad"}]},
    {"id": "ticket-entrance", "cat": "Getting around", "en": "Ticket / entrance / exit", "note": "", "forms": [{"who": "any", "to": "any", "ar": "تذكرة / الدخول / الخروج", "tr": "tazkara / ed-dukhool / el-khuroog"}]},
    {"id": "water", "cat": "Food & drink", "en": "Water, please", "note": "", "forms": [{"who": "any", "to": "any", "ar": "مية لو سمحت", "tr": "mayya law samaHt"}]},
    {"id": "tea-coffee", "cat": "Food & drink", "en": "Tea / coffee", "note": "Tea comes very sweet unless you say otherwise.", "forms": [{"who": "any", "to": "any", "ar": "شاي / قهوة", "tr": "shaay / 'ahwa"}]},
    {"id": "no-sugar", "cat": "Food & drink", "en": "Without sugar / a little sugar", "note": "", "forms": [{"who": "any", "to": "any", "ar": "من غير سكر / سكر خفيف", "tr": "min gheir sukkar / sukkar khafeef"}]},
    {"id": "delicious", "cat": "Food & drink", "en": "Delicious! / very nice", "note": "Works for food and for anything you admire.", "forms": [{"who": "any", "to": "any", "ar": "حلو أوي", "tr": "Hilw awi"}]},
    {"id": "not-spicy", "cat": "Food & drink", "en": "Not spicy, please", "note": "", "forms": [{"who": "any", "to": "any", "ar": "مش حار لو سمحت", "tr": "mish Haarr law samaHt"}]},
    {"id": "vegetarian", "cat": "Food & drink", "en": "I'm vegetarian", "note": "", "forms": [{"who": "m", "to": "any", "ar": "أنا نباتي", "tr": "ana nabaati"}, {"who": "f", "to": "any", "ar": "أنا نباتية", "tr": "ana nabatiyya"}]},
    {"id": "must-try", "cat": "Food & drink", "en": "Sugarcane juice / koshari / falafel (ta'meya)", "note": "Three things to try. Ta'meya is the Egyptian falafel, made of fava beans.", "forms": [{"who": "any", "to": "any", "ar": "عصير قصب / كشري / طعمية", "tr": "3aseer 'asab / koshari / ta3meyya"}]},
    {"id": "help", "cat": "Help & emergencies", "en": "Help me!", "note": "", "forms": [{"who": "any", "to": "m", "ar": "ساعدني", "tr": "saa3idni"}, {"who": "any", "to": "f", "ar": "ساعديني", "tr": "sa3deeni"}]},
    {"id": "doctor-pharmacy", "cat": "Help & emergencies", "en": "Doctor / pharmacy / hospital", "note": "", "forms": [{"who": "any", "to": "any", "ar": "دكتور / صيدلية / مستشفى", "tr": "duktoor / saydaliyya / mustashfa"}]},
    {"id": "im-sick", "cat": "Help & emergencies", "en": "I feel sick / I'm not well", "note": "", "forms": [{"who": "m", "to": "any", "ar": "أنا تعبان", "tr": "ana ta3baan"}, {"who": "f", "to": "any", "ar": "أنا تعبانة", "tr": "ana ta3baana"}]},
    {"id": "police", "cat": "Help & emergencies", "en": "Police / tourist police", "note": "", "forms": [{"who": "any", "to": "any", "ar": "البوليس / شرطة السياحة", "tr": "el-bulees / shurtit es-siyaaHa"}]},
    {"id": "what-time", "cat": "Help & emergencies", "en": "What time is it?", "note": "", "forms": [{"who": "any", "to": "any", "ar": "الساعة كام؟", "tr": "es-saa3a kaam?"}]},
    {"id": "time-words", "cat": "Help & emergencies", "en": "Today / tomorrow / now / later", "note": "bukra also means 'maybe never' when a plumber says it.", "forms": [{"who": "any", "to": "any", "ar": "النهارده / بكرة / دلوقتي / بعدين", "tr": "en-naharda / bukra / dilwa'ti / ba3dein"}]},
    {"id": "egypt-beautiful", "cat": "Blessings & bonding", "en": "Egypt is very beautiful", "note": "Wins hearts instantly.", "forms": [{"who": "any", "to": "any", "ar": "مصر جميلة أوي", "tr": "masr gameela awi"}]},
    {"id": "nawwart-reply", "cat": "Blessings & bonding", "en": "That's your light (reply to 'you lit up Egypt')", "note": "People will say 'nawwart masr' (you lit up Egypt). The reply is 'da noorak' (that's your light).", "forms": [{"who": "any", "to": "m", "ar": "ده نورك", "tr": "da noorak"}, {"who": "any", "to": "f", "ar": "ده نورك", "tr": "da noorik"}]},
    {"id": "bless-hands", "cat": "Blessings & bonding", "en": "Bless your hands (for a cook, a craftsman, a driver)", "note": "The best compliment for food or work.", "forms": [{"who": "any", "to": "m", "ar": "تسلم إيدك", "tr": "tislam eedak"}, {"who": "any", "to": "f", "ar": "تسلم إيدك", "tr": "tislam eedik"}]},
    {"id": "inshallah", "cat": "Blessings & bonding", "en": "God willing", "note": "Use it for anything in the future.", "forms": [{"who": "any", "to": "any", "ar": "إن شاء الله", "tr": "in shaa' allaah"}]},
    {"id": "hamdulillah", "cat": "Blessings & bonding", "en": "Thank God", "note": "After eating, arriving, surviving a taxi.", "forms": [{"who": "any", "to": "any", "ar": "الحمد لله", "tr": "el-Hamdu lillaah"}]},
    {"id": "ramadan-eid", "cat": "Blessings & bonding", "en": "Congratulations / happy holiday", "note": "mabrook for anything good; kull sana wenta tayyib for holidays and birthdays.", "forms": [{"who": "any", "to": "any", "ar": "مبروك / كل سنة وانت طيب", "tr": "mabrook / kull sana w-enta tayyib"}]},
    {"id": "numbers-1-5", "cat": "Numbers & money", "en": "1, 2, 3, 4, 5", "note": "Egypt writes prices with these digits: ١ ٢ ٣ ٤ ٥. Numbers read left to right even inside Arabic text.", "forms": [{"who": "any", "to": "any", "ar": "١ ٢ ٣ ٤ ٥", "tr": "waaHid, itnein, talaata, arba3a, khamsa"}]},
    {"id": "numbers-6-10", "cat": "Numbers & money", "en": "6, 7, 8, 9, 10", "note": "Watch the look-alikes: ٥ (5) looks like a zero, ٦ (6) looks like a 7, ٧ (7) looks like a V, and the real zero is a dot ٠. So ٥٠ is 50 and ١٠ is 10.", "forms": [{"who": "any", "to": "any", "ar": "٦ ٧ ٨ ٩ ١٠", "tr": "sitta, sab3a, tamanya, tis3a, 3ashara"}]},
    {"id": "numbers-big", "cat": "Numbers & money", "en": "20, 50, 100, 200, 1000, half", "note": "", "forms": [{"who": "any", "to": "any", "ar": "٢٠ / ٥٠ / ١٠٠ / ٢٠٠ / ١٠٠٠ / نص", "tr": "3ishreen / khamseen / miyya / miteen / alf / nuss"}]},
    {"id": "pounds", "cat": "Numbers & money", "en": "Egyptian pound(s)", "note": "gineh = one pound; after numbers 3-10 say 'gineh' too (khamsa gineh = 5 pounds); 'fifty pounds' = khamseen gineh.", "forms": [{"who": "any", "to": "any", "ar": "جنيه", "tr": "gineh"}]},
    {"id": "baksheesh", "cat": "Numbers & money", "en": "Tip (baksheesh)", "note": "You'll hear it a lot. See the Basics entry on tipping etiquette.", "forms": [{"who": "any", "to": "any", "ar": "بقشيش", "tr": "ba'sheesh"}]}
  ]
}
